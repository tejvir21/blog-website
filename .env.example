# Copy this file to .env and replace every placeholder.
FLASK_KEY=replace-with-a-random-secret-key
FLASK_APP=server.py

# PostgreSQL connection URL. Add ?sslmode=require if your provider requires SSL.
DB_URI=postgresql+psycopg2://username:password@localhost:5432/blogwebsite

# Gmail account and app password used by the contact form.
EMAIL_KEY=your-gmail-address@gmail.com
PASSWORD_KEY=your-gmail-app-password
RECEIVE_EMAIL_KEY=recipient@example.com
